# The host name the site is served under.
SITE_HOST=notes.example.com
# Where notefeed listens: the server's private address and notefeed's port (PRIVATE_IP in ../notefeed/.env).
UPSTREAM=10.0.0.3:3000
# Where NocoDB listens (../nocodb), served under report.<SITE_HOST>.
REPORT_UPSTREAM=10.0.0.3:8080
# Where Let's Encrypt sends its warnings.
ACME_EMAIL=letsencrypt@example.com
