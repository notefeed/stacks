# The host name the site is served under.
SITE_HOST=notes.example.com
# Where notefeed listens: the server's private address and notefeed's port (PRIVATE_IP in ../notefeed/.env).
UPSTREAM=10.0.0.3:3000
# Where Let's Encrypt sends its warnings.
ACME_EMAIL=letsencrypt@example.com
# gesetze-fuer-ki.de (its compose file is in Gesetze-fuer-KI/stacks, checked out next to this repository): its host name, the names that redirect to it, and where its container
# listens.
GESETZE_HOST=gesetze-fuer-ki.de
GESETZE_REDIRECTS=www.gesetze-fuer-ki.de, xn--gesetze-fr-ki-4ob.de, www.xn--gesetze-fr-ki-4ob.de, gesetze-fuer-ki.online, www.gesetze-fuer-ki.online, xn--gesetze-fr-ki-4ob.online, www.xn--gesetze-fr-ki-4ob.online
GESETZE_UPSTREAM=10.0.0.3:8081
# gamepanion.app (its compose file is in gamepanion/stacks, checked out next to this repository): its host name, the names that
# redirect to it, and where its container listens.
GAMEPANION_HOST=gamepanion.app
GAMEPANION_REDIRECTS=www.gamepanion.app
GAMEPANION_UPSTREAM=10.0.0.3:8082
