{
	email {$ACME_EMAIL}

	# Caddy's own log: its error lines describe the request, so they get the same treatment as the access log.
	log {
		import /etc/caddy/access-log.caddy
	}
}

# The name with www in front only forwards. It needs its own DNS record; delete this block if there is none.
www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

{$SITE_HOST} {
	encode zstd gzip

	# One line per request, without anything that says who it was or which feed it was for: see access-log.caddy.
	log {
		output stdout
		import /etc/caddy/access-log.caddy
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# A note with its pictures is one request: the text and up to ten images of at most 10 MiB each.
	request_body {
		max_size 120MB
	}

	# notefeed takes the client's address from the last entry of X-Forwarded-For (NOTEFEED_TRUST_PROXY=1). Caddy writes
	# that header itself and does not pass on one a client sent.
	reverse_proxy {$UPSTREAM}
}

# gesetze-fuer-ki.de (../gesetze-fuer-ki): the documentation at /, the MCP endpoint at /mcp, both from one container.
# Its other names (www., gesetze-für-ki.de, the .online pair; the list is GESETZE_REDIRECTS) all lead to the one name.
# 308 keeps the method, so an MCP client that POSTs to an old name still reaches /mcp.
{$GESETZE_REDIRECTS} {
	redir https://{$GESETZE_HOST}{uri} 308
}

{$GESETZE_HOST} {
	encode zstd gzip

	# The same line per request as for notefeed: no client address, and no query string or body, so what people look up
	# in the law is never written down (the privacy page at /datenschutz/ says so).
	log {
		output stdout
		import /etc/caddy/access-log.caddy
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# MCP answers can be a stream of events: pass each one on at once.
	reverse_proxy {$GESETZE_UPSTREAM} {
		flush_interval -1
	}
}
