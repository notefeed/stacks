# Where the monitoring server's Loki listens on the private network.
LOKI_URL=http://10.0.0.2:3100
PRODUCT=notefeed
HOST_NAME=notefeed-1
PRIVATE_IP=10.0.0.3
# The public key of the Beszel hub.
BESZEL_KEY=
# Uptime Kuma on the monitoring server, for AutoKuma (started with the profile `autokuma`). The account is Uptime
# Kuma's own; the topic is the one at ntfy.sh that alerts go to, and its name is a secret.
KUMA_URL=http://10.0.0.2:3001
KUMA_USERNAME=
KUMA_PASSWORD=
NTFY_TOPIC=
