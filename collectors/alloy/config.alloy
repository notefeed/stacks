// The logs of every container on this server, to Loki, labelled with the product and the server they come from.
// Below them, the machine's own numbers and Caddy's counts, to Prometheus.
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.containers.rules
	forward_to    = [loki.write.default.receiver]
	labels        = {
		product = sys.env("PRODUCT"),
		host    = sys.env("HOST_NAME"),
	}
}

loki.write "default" {
	endpoint {
		url = sys.env("LOKI_URL") + "/loki/api/v1/push"
	}
}

// The machine itself: CPU, memory, disk, load and network, read from the host's /proc and /sys (mounted under /host) by the
// exporter built into Alloy, and sent to Prometheus on the monitoring server. Nothing listens for it on this server.
// systemd: the state and the last start of the backup units (notefeed-dump-*, notefeed-offsite), asked over the host's D-Bus
// socket, for the backup age on the operator dashboard. Only those units: their names, never what they hold.
prometheus.exporter.unix "host" {
	procfs_path    = "/host/proc"
	sysfs_path     = "/host/sys"
	rootfs_path    = "/host/root"
	set_collectors = ["cpu", "meminfo", "filesystem", "loadavg", "diskstats", "netdev", "systemd"]

	netdev {
		// The host's own interfaces: the containers' virtual ones and the bridges count the same bytes again.
		device_exclude = "^(lo|veth.*|docker.*|br-.*)$"
	}

	systemd {
		unit_include = "notefeed-(dump-.+|offsite)\\.(service|timer)"
		start_time   = true
	}

	filesystem {
		mount_points_exclude = "^/(dev|proc|sys|run|boot|var/lib/docker)($|/)"
		fs_types_exclude     = "^(tmpfs|overlay|squashfs|proc|sysfs|devtmpfs|cgroup2?|nsfs|autofs|binfmt_misc|vfat)$"
	}
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.host.receiver]
}

// The same two labels the logs carry, so a server reads the same in both.
prometheus.relabel "host" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		target_label = "host"
		replacement  = sys.env("HOST_NAME")
	}

	rule {
		target_label = "product"
		replacement  = sys.env("PRODUCT")
	}

	rule {
		target_label = "instance"
		replacement  = sys.env("HOST_NAME")
	}
}

// Caddy's counts per host name (../caddy, the global option `metrics`), from its admin endpoint on this host. Caddy calls
// the host name `host`, which here is the server's name, so it becomes `site`. Only the totals are kept, not the
// histograms' buckets nor Go's own numbers: a year of them stays small. Where there is no Caddy, the target is down.
prometheus.scrape "caddy" {
	targets         = [{"__address__" = "127.0.0.1:2019"}]
	job_name        = "caddy"
	scrape_interval = "60s"
	forward_to      = [prometheus.relabel.caddy.receiver]
}

prometheus.relabel "caddy" {
	forward_to = [prometheus.relabel.host.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "caddy_http_(requests_total|request_duration_seconds_(count|sum)|request_size_bytes_(count|sum)|response_size_bytes_(count|sum))|up"
		action        = "keep"
	}

	rule {
		source_labels = ["host"]
		target_label  = "site"
	}

	rule {
		regex  = "host"
		action = "labeldrop"
	}
}

// PostgreSQL's statistics from the exporter in ../compose.yaml (profile `postgres`): the server-wide ones, notefeed's
// tables and the transactions running now. No query text, no data. Without the exporter the target is down.
prometheus.scrape "postgres" {
	targets         = [{"__address__" = "127.0.0.1:9187"}]
	job_name        = "postgres"
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.postgres.receiver]
}

prometheus.relabel "postgres" {
	forward_to = [prometheus.relabel.host.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "pg_(up|database_size_bytes|stat_database_.+|locks_count|stat_activity_(count|max_tx_duration)|stat_user_tables_.+|stat_bgwriter_.+|stat_checkpointer_.+)|up"
		action        = "keep"
	}
}

prometheus.remote_write "default" {
	endpoint {
		url = sys.env("PROMETHEUS_URL") + "/api/v1/write"
	}
}
