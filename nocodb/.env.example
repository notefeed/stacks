# This server's address on the private network: Caddy reaches NocoDB there.
PRIVATE_IP=10.0.0.3
# The host name of the site; the form is served under report.<SITE_HOST>.
SITE_HOST=notes.example.com
# The operator's login. The password: 8 characters or more, with a capital, a digit and a symbol (NocoDB's rule).
NC_ADMIN_EMAIL=abuse@example.com
NC_ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
NC_AUTH_JWT_SECRET=
