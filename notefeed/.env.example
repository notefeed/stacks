# This server's address on the private network: notefeed listens there for the monitoring server's scrapes.
PRIVATE_IP=10.0.0.3

PUBLIC_URL=https://notes.example.com
# Behind Caddy on gewerbe-1, which says who the client is.
NOTEFEED_TRUST_PROXY=1
NOTEFEED_TITLE=notefeed
TZ=Europe/Berlin

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
NOTEFEED_SECRET=
NOTEFEED_S3_ACCESS_KEY=
NOTEFEED_S3_SECRET_KEY=
NOTEFEED_OPERATOR_TOKEN=
NOTEFEED_METRICS=1
NOTEFEED_METRICS_TOKEN=

# 0 refuses every picture; empty takes them.
NOTEFEED_IMAGE_UPLOADS=
# The "Report" link on every note: the form in ../nocodb with the note's ids filled in (see nocodb/README.md); empty for none.
NOTEFEED_REPORT_URL=

# Optional: feeds only the operator posts to, and their password.
NOTEFEED_RESERVED_FEEDS=
NOTEFEED_RESERVED_PASSWORD=
NOTEFEED_FOOTER_FEEDS=

# Storage: PostgreSQL (the URL is built in compose.yaml from POSTGRES_PASSWORD), images in the Versity S3 gateway (s3).
NOTEFEED_STORAGE=postgres
NOTEFEED_IMAGES=s3
NOTEFEED_S3_ENDPOINT=http://s3:7070
NOTEFEED_S3_BUCKET=notefeed-images
NOTEFEED_S3_REGION=us-east-1

# Encryption at rest with the main key in OpenBao on the monitoring server (notefeed/notefeed #212, #215): notefeed holds no
# key, only its AppRole. Its address is built in compose.yaml from OPENBAO_IP. While OpenBao does not answer, notefeed.me
# shows its maintenance page.
NOTEFEED_KMS=openbao
OPENBAO_IP=
NOTEFEED_OPENBAO_ROLE_ID=
NOTEFEED_OPENBAO_SECRET_ID=

# This instance's own pages (./legal, mounted at /legal): imprint, privacy and terms; notefeed ships none of them. The license
# page's words (notefeed/notefeed #218, ADR 0035): with a payment provider set, notefeed does not serve without this file.
NOTEFEED_IMPRINT_FILE=/legal/imprint.md
NOTEFEED_PRIVACY_FILE=/legal/privacy.md
NOTEFEED_TERMS_FILE=/legal/terms.md
NOTEFEED_LICENSE_FILE=/legal/license.md
# The footer's "Support" link.
NOTEFEED_SUPPORT_EMAIL=support@notefeed.me
# Accounts (notefeed/notefeed #387): a number, a recovery key and passkeys, no e-mail. Open: anyone may make one; feeds stay
# open unless their owner protects them. Licenses are on the account (ADR 0061).
NOTEFEED_ACCOUNTS=open
# The accounts, their sessions, tokens and license subscriptions are a SQLite file of their own (./data/accounts, mounted at
# /accounts), next to the database but not in it.
NOTEFEED_ACCOUNTS_DB=/accounts/accounts.sqlite
# The account that owns the reserved feeds (releases, news): its number, from the account page.
NOTEFEED_OPERATOR_ACCOUNT=
