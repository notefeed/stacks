# This server's address on the private network: notefeed listens there for the monitoring server's scrapes.
PRIVATE_IP=10.0.0.3

PUBLIC_URL=https://notes.example.com
NOTEFEED_TITLE=notefeed
TZ=Europe/Berlin

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
NOTEFEED_SECRET=
NOTEFEED_S3_ACCESS_KEY=
NOTEFEED_S3_SECRET_KEY=
NOTEFEED_OPERATOR_TOKEN=
NOTEFEED_METRICS=1
NOTEFEED_METRICS_TOKEN=

# Optional: feeds only the operator posts to, and their password.
NOTEFEED_RESERVED_FEEDS=
NOTEFEED_RESERVED_PASSWORD=
